{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "autonomy missing record",
  "description": "AUTONOMY-MVP-GOAL-GUIDE §5.1 记录封套 + §5.4 Missing。recordId 恒等于 payload.missingId。",
  "type": "object",
  "required": ["recordId", "recordType", "schemaVersion", "manifestId", "createdAt", "producer", "dependencyRefs", "payload"],
  "additionalProperties": false,
  "properties": {
    "recordId": { "type": "string", "pattern": "^MISS:[0-9a-f]{16}$" },
    "recordType": { "type": "string", "const": "missing" },
    "schemaVersion": { "type": "string", "const": "1" },
    "manifestId": { "type": "string", "pattern": "^AM-[0-9a-f]{16}$" },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "producer": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["analyzer", "model", "host"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "dependencyRefs": { "type": "array", "items": { "type": "string" } },
    "payload": {
      "type": "object",
      "required": [
        "missingId", "questionId", "category", "reasonCode",
        "targetRefs", "whyNeeded", "blocking", "nextActions", "terminalReason"
      ],
      "additionalProperties": false,
      "properties": {
        "missingId": { "type": "string", "pattern": "^MISS:[0-9a-f]{16}$" },
        "questionId": { "type": "string", "pattern": "^Q:[0-9a-f]{16}$" },
        "category": {
          "type": "string",
          "enum": ["data", "tool", "precision", "environment", "conflict", "model-capability", "budget", "authorization"]
        },
        "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "targetRefs": { "type": "array", "items": { "type": "string" } },
        "whyNeeded": { "type": "string", "minLength": 4 },
        "blocking": { "type": "boolean" },
        "nextActions": { "type": "array", "items": { "type": "string" } },
        "terminalReason": { "type": ["string", "null"] }
      }
    }
  }
}
