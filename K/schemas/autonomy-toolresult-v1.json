{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "autonomy tool-result record",
  "description": "AUTONOMY-MVP-GOAL-GUIDE §5.1 记录封套 + §5.5 ToolResult。recordId 恒等于 payload.resultId。",
  "type": "object",
  "required": ["recordId", "recordType", "schemaVersion", "manifestId", "createdAt", "producer", "dependencyRefs", "payload"],
  "additionalProperties": false,
  "properties": {
    "recordId": { "type": "string", "pattern": "^EVID:[0-9a-f]{16}$" },
    "recordType": { "type": "string", "const": "tool-result" },
    "schemaVersion": { "type": "string", "const": "1" },
    "manifestId": { "type": "string", "pattern": "^AM-[0-9a-f]{16}$" },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "producer": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["analyzer", "model", "host"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "dependencyRefs": { "type": "array", "items": { "type": "string" } },
    "payload": {
      "type": "object",
      "required": [
        "resultId", "tool", "toolVersion", "status", "questionId", "inputManifestId",
        "answer", "assumptions", "evidenceRefs", "counterEvidenceRefs", "sourceWindows",
        "completeness", "missingRefs", "nextActions", "requiresInterpretation", "usage"
      ],
      "additionalProperties": false,
      "properties": {
        "resultId": { "type": "string", "pattern": "^EVID:[0-9a-f]{16}$" },
        "tool": { "type": "string", "minLength": 1 },
        "toolVersion": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["ok", "error", "unsupported", "cancelled"] },
        "questionId": { "type": ["string", "null"] },
        "inputManifestId": { "type": "string", "minLength": 3 },
        "answer": {
          "type": "object",
          "required": ["status", "text", "basis", "assurance"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string", "enum": ["unknown", "supported", "refuted"] },
            "text": { "type": "string" },
            "basis": { "type": "string", "enum": ["derived", "observed"] },
            "assurance": { "type": "string", "enum": ["observation", "bounded-analysis", "model-assessment"] }
          }
        },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } },
        "counterEvidenceRefs": { "type": "array", "items": { "type": "string" } },
        "sourceWindows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "startLine", "endLine", "sha256"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "startLine": { "type": "integer", "minimum": 1 },
              "endLine": { "type": "integer", "minimum": 1 },
              "sha256": { "type": ["string", "null"] }
            }
          }
        },
        "completeness": {
          "type": "object",
          "required": ["scope", "enumeration", "unresolvedRefs", "truncated", "nextCursor"],
          "additionalProperties": false,
          "properties": {
            "scope": { "type": "string", "minLength": 1 },
            "enumeration": { "type": "string", "enum": ["partial", "complete"] },
            "unresolvedRefs": { "type": "array", "items": { "type": "string" } },
            "truncated": { "type": "boolean" },
            "nextCursor": { "type": ["string", "null"] }
          }
        },
        "missingRefs": { "type": "array", "items": { "type": "string", "pattern": "^MISS:[0-9a-f]{16}$" } },
        "nextActions": { "type": "array", "items": { "type": "string" } },
        "requiresInterpretation": { "type": "boolean" },
        "observations": { "type": ["object", "null"], "additionalProperties": true },
        "errorCode": { "type": ["string", "null"] },
        "usage": {
          "type": "object",
          "required": ["wallMs", "bytesRead", "cacheHit"],
          "additionalProperties": false,
          "properties": {
            "wallMs": { "type": "integer", "minimum": 0 },
            "bytesRead": { "type": "integer", "minimum": 0 },
            "cacheHit": { "type": "boolean" }
          }
        }
      }
    }
  }
}
