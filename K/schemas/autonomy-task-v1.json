{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "autonomy task record",
  "description": "AGENT-ARCHITECTURE-GUIDE.md §5.4/§9.1 记录与 Task。recordId 恒等于 payload.taskId。",
  "type": "object",
  "required": ["recordId", "recordType", "schemaVersion", "manifestId", "createdAt", "producer", "dependencyRefs", "payload"],
  "additionalProperties": false,
  "properties": {
    "recordId": { "type": "string", "pattern": "^TASK:[0-9a-f]{16}$" },
    "recordType": { "type": "string", "const": "task" },
    "schemaVersion": { "type": "string", "const": "1" },
    "manifestId": { "type": "string", "pattern": "^AM-[0-9a-f]{16}$" },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "producer": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["analyzer", "model", "host"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "dependencyRefs": { "type": "array", "items": { "type": "string" } },
    "payload": {
      "type": "object",
      "required": ["taskId", "origin", "anchorRefs", "question", "state", "questionRefs", "missingRefs", "revision"],
      "additionalProperties": false,
      "properties": {
        "taskId": { "type": "string", "pattern": "^TASK:[0-9a-f]{16}$" },
        "origin": { "type": "string", "enum": ["entry-scan", "coverage-sample", "analysis-branch"] },
        "anchorRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(ENT|F):" } },
        "operationRef": { "type": "string", "pattern": "^F:" },
        "question": { "type": "string", "minLength": 8 },
        "state": { "type": "string", "enum": ["queued", "running", "done", "blocked", "failed"] },
        "questionRefs": { "type": "array", "items": { "type": "string", "pattern": "^Q:[0-9a-f]{16}$" } },
        "missingRefs": { "type": "array", "items": { "type": "string", "pattern": "^MISS:[0-9a-f]{16}$" } },
        "revision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
