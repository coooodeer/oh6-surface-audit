{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "autonomy question record",
  "description": "AGENT-ARCHITECTURE-GUIDE.md §5.4/§9.2 记录与 Question。recordId 恒等于 payload.questionId。",
  "type": "object",
  "required": ["recordId", "recordType", "schemaVersion", "manifestId", "createdAt", "producer", "dependencyRefs", "payload"],
  "additionalProperties": false,
  "properties": {
    "recordId": { "type": "string", "pattern": "^Q:[0-9a-f]{16}$" },
    "recordType": { "type": "string", "const": "question" },
    "schemaVersion": { "type": "string", "const": "1" },
    "manifestId": { "type": "string", "pattern": "^AM-[0-9a-f]{16}$" },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "producer": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["analyzer", "model", "host"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "dependencyRefs": { "type": "array", "items": { "type": "string" } },
    "payload": {
      "type": "object",
      "required": [
        "questionId", "taskId", "kind", "proposition", "polarity",
        "status", "basis", "assurance", "evidenceRefs", "missingRefs"
      ],
      "additionalProperties": false,
      "properties": {
        "questionId": { "type": "string", "pattern": "^Q:[0-9a-f]{16}$" },
        "taskId": { "type": "string", "pattern": "^TASK:[0-9a-f]{16}$" },
        "kind": { "type": "string", "enum": ["binding", "check-presence", "dominance", "authorization-effect", "permission-argument-match", "static-contract", "static-permission-match", "contract-deviation", "security-decision", "input-boundary-local", "operation-local"] },
        "proposition": { "type": "string", "minLength": 4 },
        "polarity": { "type": "string", "enum": ["exists", "forall"] },
        "status": { "type": "string", "enum": ["unknown", "supported", "refuted", "insufficient", "conflict", "not-applicable"] },
        "basis": { "type": "string", "enum": ["observed", "derived", "llm", "mixed"] },
        "assurance": { "type": "string", "enum": ["observation", "bounded-analysis", "model-assessment"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "pattern": "^EVID:[0-9a-f]{16}$" } },
        "missingRefs": { "type": "array", "items": { "type": "string", "pattern": "^MISS:[0-9a-f]{16}$" } }
      }
    }
  }
}
