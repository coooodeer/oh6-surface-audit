{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "autonomy context packet record",
  "description": "AGENT-ARCHITECTURE-GUIDE.md §10.3 ContextPacket：入口、绑定候选、函数窗口（≤80 行）、guards、calls、metadata、token 估算与截断声明。",
  "type": "object",
  "required": ["recordId", "recordType", "schemaVersion", "manifestId", "createdAt", "producer", "dependencyRefs", "payload"],
  "additionalProperties": false,
  "properties": {
    "recordId": { "type": "string", "pattern": "^CTX:[0-9a-f]{16}$" },
    "recordType": { "type": "string", "const": "context" },
    "schemaVersion": { "type": "string", "const": "1" },
    "manifestId": { "type": "string", "pattern": "^AM-[0-9a-f]{16}$" },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "producer": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["analyzer", "model", "host"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "dependencyRefs": { "type": "array", "items": { "type": "string" } },
    "payload": {
      "type": "object",
      "required": [
        "contextId", "taskId", "entryRef", "binding", "window", "guards", "calls",
        "metadata", "estimatedInputTokens", "truncated", "omittedRefs", "sufficiency"
      ],
      "additionalProperties": false,
      "properties": {
        "contextId": { "type": "string", "pattern": "^CTX:[0-9a-f]{16}$" },
        "taskId": { "type": "string", "pattern": "^TASK:[0-9a-f]{16}$" },
        "entryRef": { "type": "string", "minLength": 3 },
        "binding": { "type": "string", "enum": ["resolved", "suspect", "unbound"] },
        "window": {
          "type": ["object", "null"],
          "required": ["file", "startLine", "endLine", "lines", "sha256"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "startLine": { "type": "integer", "minimum": 1 },
            "endLine": { "type": "integer", "minimum": 1 },
            "lines": { "type": "integer", "minimum": 0 },
            "sha256": { "type": ["string", "null"] }
          }
        },
        "guards": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "calls": { "type": "array", "items": { "type": "string" } },
        "metadata": { "type": "object", "additionalProperties": true },
        "estimatedInputTokens": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "omittedRefs": { "type": "array", "items": { "type": "string" } },
        "sufficiency": { "type": "string", "enum": ["sufficient", "partial", "insufficient"] }
      }
    }
  }
}
