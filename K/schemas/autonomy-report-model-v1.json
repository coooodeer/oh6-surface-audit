{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "autonomy report-model record",
  "description": "报告模型；static-v1 在充分静态证据下允许 static-only finding。recordId 恒等于 payload.reportId。",
  "type": "object",
  "required": ["recordId", "recordType", "schemaVersion", "manifestId", "createdAt", "producer", "dependencyRefs", "payload"],
  "additionalProperties": false,
  "properties": {
    "recordId": { "type": "string", "pattern": "^R:[0-9a-f]{16}$" },
    "recordType": { "type": "string", "const": "report-model" },
    "schemaVersion": { "type": "string", "const": "1" },
    "manifestId": { "type": "string", "pattern": "^AM-[0-9a-f]{16}$" },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "producer": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["analyzer", "model", "host"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "dependencyRefs": { "type": "array", "items": { "type": "string" } },
    "payload": {
      "type": "object",
      "required": [
        "reportId", "taskId", "entryRef", "reportability", "decision",
        "missing", "evidenceRefs", "manifestId", "snapshotId"
      ],
      "additionalProperties": false,
      "properties": {
        "reportId": { "type": "string", "pattern": "^R:[0-9a-f]{16}$" },
        "taskId": { "type": "string", "pattern": "^TASK:[0-9a-f]{16}$" },
        "entryRef": { "type": "string", "minLength": 3 },
        "origin": { "type": "string", "enum": ["entry-scan", "coverage-sample", "analysis-branch"] },
        "reportability": { "type": "string", "enum": ["candidate", "observation", "excluded", "finding"] },
        "verificationStatus": { "type": "string", "const": "static-only" },
        "assurance": { "type": "string", "enum": ["bounded-analysis", "model-assessment"] },
        "normRef": { "type": "string", "pattern": "^NORM:" },
        "reviewRef": { "type": "string", "pattern": "^REVIEW:" },
        "operationRef": { "type": "string", "pattern": "^F:" },
        "expectedPermission": { "type": "string", "minLength": 1 },
        "observedPermission": { "type": "string", "minLength": 1 },
        "limitation": { "type": "string", "minLength": 12 },
        "decision": { "type": "string", "enum": ["supported", "refuted", "insufficient", "conflict"] },
        "permissionArgument": {
          "type": "object",
          "required": ["questionId", "decision", "evidenceRefs"],
          "additionalProperties": false,
          "properties": {
            "questionId": { "type": "string", "pattern": "^Q:[0-9a-f]{16}$" },
            "decision": { "type": "string", "enum": ["supported", "refuted", "insufficient"] },
            "evidenceRefs": { "type": "array", "items": { "type": "string", "pattern": "^EVID:[0-9a-f]{16}$" } }
          }
        },
        "missing": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "pattern": "^EVID:[0-9a-f]{16}$" } },
        "manifestId": { "type": "string", "pattern": "^AM-[0-9a-f]{16}$" },
        "snapshotId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
