{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "autonomy run record (RunContext)",
  "description": "AGENT-ARCHITECTURE-GUIDE.md §5.1/§5.4 RunContext 记录。recordId 恒等于 payload.runId。",
  "type": "object",
  "required": ["recordId", "recordType", "schemaVersion", "manifestId", "createdAt", "producer", "dependencyRefs", "payload"],
  "additionalProperties": false,
  "properties": {
    "recordId": { "type": "string", "pattern": "^RUN:[0-9a-f]{16}$" },
    "recordType": { "type": "string", "const": "run" },
    "schemaVersion": { "type": "string", "const": "1" },
    "manifestId": { "type": "string", "pattern": "^AM-[0-9a-f]{16}$" },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "producer": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["analyzer", "model", "host"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "dependencyRefs": { "type": "array", "items": { "type": "string" } },
    "payload": {
      "type": "object",
      "required": [
        "runId", "architectureVersion", "schemaVersion", "inputManifestId", "snapshotId",
        "scopeId", "knowledgeVersion", "mode", "capabilityProfile", "budget"
      ],
      "additionalProperties": false,
      "properties": {
        "runId": { "type": "string", "pattern": "^RUN:[0-9a-f]{16}$" },
        "architectureVersion": { "type": "string", "enum": ["1.0.0-mvp", "1.0.1-auth-experiment", "1.0.2-auth-experiment", "1.0.3-vertical-experiment", "1.0.4-vertical-experiment", "1.0.5-vertical-experiment", "1.0.6-vertical-experiment", "1.0.7-vertical-experiment", "1.0.8-vertical-experiment", "1.0.9-vertical-experiment", "1.0.10-vertical-experiment", "1.0.11-vertical-experiment", "1.0.12-vertical-experiment", "1.0.13-vertical-experiment", "1.0.14-static-experiment", "1.0.15-static-scan", "1.0.16-static-scan", "1.0.17-static-scan", "1.0.18-static-arbitration", "1.0.19-autonomous-static", "1.0.20-security-verdict", "1.0.21-sa-method-verdict", "1.0.22-ipc-code-verdict", "1.0.23-rust-ipc-code-verdict"] },
        "schemaVersion": { "type": "string", "const": "1" },
        "inputManifestId": { "type": "string", "minLength": 3 },
        "snapshotId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "scopeId": { "type": "string", "minLength": 1 },
        "knowledgeVersion": { "type": ["string", "null"] },
        "modelId": { "type": "string", "minLength": 3 },
        "mode": { "type": "string", "enum": ["off", "live", "mock", "replay"] },
        "capabilityProfile": { "type": "string", "enum": ["readonly-local", "model-enabled"] },
        "budget": {
          "type": "object",
          "required": [
            "maxModelRequests", "maxToolCalls", "maxInputTokens", "maxOutputTokens",
            "maxWallSeconds", "maxTasks", "maxTaskModelRequests", "maxTaskToolCalls",
            "maxConcurrentTools", "maxConcurrentModels"
          ],
          "additionalProperties": false,
          "properties": {
            "maxModelRequests": { "type": "integer", "minimum": 0 },
            "maxToolCalls": { "type": "integer", "minimum": 0 },
            "maxInputTokens": { "type": "integer", "minimum": 0 },
            "maxOutputTokens": { "type": "integer", "minimum": 0 },
            "maxWallSeconds": { "type": "integer", "minimum": 0 },
            "maxTasks": { "type": "integer", "minimum": 0 },
            "maxTaskModelRequests": { "type": "integer", "minimum": 0 },
            "maxTaskToolCalls": { "type": "integer", "minimum": 0 },
            "maxConcurrentTools": { "type": "integer", "minimum": 1 },
            "maxConcurrentModels": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
