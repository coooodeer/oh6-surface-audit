{
  "policyId": "asset-r3",
  "version": "1.0.0",
  "description": "R3 非 C/C++ 形态事实范围：base/security/asset 的 Rust/C/C++ 生产代码与元数据（独立快照，不改写旧快照）。",
  "snapshotScope": "asset-r3",
  "roots": [
    { "root": "base/security/asset", "part": "security" }
  ],
  "compdbParts": ["security"],
  "sourceExtensions": [".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx", ".rs"],
  "cExtensions": [".c"],
  "testPathPattern": "/(test|tests|unittest|fuzztest|mock|moduletest|systemtest)/",
  "testFilePattern": "(_test|_unittest|_fuzzer|_mock)\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|rs)$",
  "limits": {
    "maxIndexFunctions": 9000,
    "maxIndexCalls": 50000
  },
  "metadataSources": [
    { "kind": "idl", "glob": "**/*.idl", "scope": "roots", "required": false },
    { "kind": "sa", "glob": "**/sa_profile/**/*.json", "scope": "roots", "required": true },
    { "kind": "permission", "glob": "**/*permission*.json", "scope": "roots", "required": false },
    { "kind": "napi", "glob": null, "scope": "code-derived", "required": false },
    { "kind": "harness", "glob": null, "scope": "definition-pending", "required": false },
    {
      "kind": "permission-authority",
      "file": "base/security/access_token/services/accesstokenmanager/permission_definitions.json",
      "scope": "external-authority",
      "required": false
    }
  ]
}
